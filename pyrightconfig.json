{
  "typeCheckingMode": "basic",
  "include": [
    "backend"
  ],
  "exclude": [
    "backend/.venv",
    "backend/**/__pycache__",
    "frontend/node_modules",
    "frontend/dist"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        "."
      ]
    }
  ]
}
